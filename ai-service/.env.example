# Shared secret for the Laravel <-> FastAPI HMAC header (spec §6.2).
#
# REQUIRED, and deliberately left empty: app/config.py has no default for it
# and the service refuses to start until it is set. A default would be a
# secret printed in a public repository, and anyone could then sign a request
# this analyzer accepts. The same value must be set on the Laravel backend.
#
#   openssl rand -hex 32
AI_SERVICE_HMAC_SECRET=

LOG_LEVEL=INFO

# Sentiment backend: auto | onnx | lexicon
#   auto     use ONNX when its weights and the optional "onnx" dependency
#            extra are present, otherwise fall back to the lexicon backend
#            with a start-up warning. This is what a fresh checkout and CI get.
#   onnx     require ONNX; fail loudly if the weights are missing. The
#            container image pins this so a broken weights layer breaks the
#            deploy instead of silently degrading analysis quality.
#   lexicon  never touch ONNX.
# The active backend is part of model_version and is reported by GET /health.
# The two are NOT equivalent in quality — see MODEL_CARD.md.
SENTIMENT_BACKEND=auto

# Directory holding model_int8.onnx, tokenizer.json and config.json.
# Populated at image build time by scripts/fetch_sentiment_model.py; never
# fetched at runtime (ADR-0004: weights are a build artifact). Defaults to
# ai-service/models/sentiment, which is gitignored.
# SENTIMENT_MODEL_DIR=/opt/models/sentiment

# ONNX Runtime intra-op threads. 1 keeps p95 independent of how many
# requests happen to overlap; uvicorn supplies the concurrency.
SENTIMENT_INTRA_OP_THREADS=1

# Escape hatch: force a specific model_version string, e.g. while
# reproducing an old analysis during an incident. Leave unset normally —
# the computed value is the one that carries meaning.
# PINNED_MODEL_VERSION=
