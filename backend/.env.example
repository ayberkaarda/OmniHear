APP_NAME=OmniHear
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=omnihear
DB_USERNAME=omnihear
DB_PASSWORD=omnihear

# Structured logging (spec 3.6). `json` writes one JSON object per line;
# LOG_JSON_STREAM sends it to the container's stderr so `docker compose logs`
# and any collector see it. Point it at a file path for a local checkout.
LOG_CHANNEL=json
LOG_LEVEL=debug
LOG_JSON_STREAM=php://stderr

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=omnihear
REVERB_APP_KEY=REPLACE_ME
REVERB_APP_SECRET=REPLACE_ME
REVERB_HOST=localhost
REVERB_PORT=8080

AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_HMAC_SECRET=REPLACE_ME
AI_SERVICE_TIMEOUT=5

STRIPE_KEY=REPLACE_ME
STRIPE_SECRET=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
IYZICO_API_KEY=REPLACE_ME
IYZICO_SECRET_KEY=REPLACE_ME
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

FRONTEND_URL=http://localhost:4200
