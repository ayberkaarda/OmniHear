{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "lint": "ng lint",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:check": "node scripts/tokens-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build:gate": "node scripts/bundle-check.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "private": true,
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/localize": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "angular-eslint": "22.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  }
